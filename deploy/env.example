# Stack env file for deploy/compose.yml: the ONE file with every server-specific value. On a server set up by
# deploy/install.sh it is /opt/wok/.env (mode 600, owner wok; install.sh creates it from this template). By hand:
# copy it OUTSIDE the repo and pass it with ENV_FILE=<path> plus `--env-file <path>`. Names and comments only here:
# never commit values.
# Lines left commented use the code's default (backend/app/config.py). Don't leave a typed setting (number,
# list, choice) as an empty `NAME=`: the API refuses to start; comment it out instead.

# ---------------------------------------------------------------------------------------------------------------
# Compose (read by `docker compose` for ${...}; the containers never see these unless listed again below)
# ---------------------------------------------------------------------------------------------------------------
# Images to run. Servers: the private GHCR images CI pushes (#59) and the tag the deploy button moves (#60).
# `wok` defaults: ghcr.io/juyoungml/nemo-k-cards-api, ghcr.io/juyoungml/nemo-k-cards-admin, tag staging
# (build mode: nemo-k-cards-api, nemo-k-cards-admin, tag staging, all local).
# Plain `docker compose` (local builds) defaults to nemo-k-cards-{api,admin}:local.
# API_IMAGE=
# ADMIN_IMAGE=
# IMAGE_TAG=
# Public address Caddy serves. A domain gets HTTPS from Let's Encrypt (ports 80/443 must reach this host);
# ":80" = plain HTTP behind a tunnel or for a local test. Default :80.
SITE_ADDRESS=
# Host ports. Defaults: 80/443 for Caddy, and 127.0.0.1-only 18000 (API) / 13000 (Admin) for checks on the host.
# HTTP_PORT=
# HTTPS_PORT=
# API_HOST_PORT=
# ADMIN_HOST_PORT=
# Cloudflare named tunnel token (secret). `wok` adds `--profile tunnel` when it is set; plain compose needs the flag.
# Not passed to the API container.
# TUNNEL_TOKEN=
# No Cloudflare account or domain: WOK_TUNNEL=quick starts a TryCloudflare quick tunnel (random
# https://<words>.trycloudflare.com, no open ports). The address changes whenever the tunnel restarts: `wok url`
# prints it; then update ADMIN_URL, PUBLIC_ASSET_BASE_URL and the Supabase redirect list. Staging and demos only.
# WOK_TUNNEL=
# Admin build args, used only when compose BUILDS the Admin (CI passes the same names). Public by design:
# they end up in every browser. The Supabase project's URL and its publishable key (sb_publishable_…), never
# a secret key. NEXT_PUBLIC_API_URL defaults to /backend (same origin through Caddy); leave it unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------------------------------------------
# Host only (install.sh and `wok`). Lines starting GHCR_ / WOK_ and TUNNEL_TOKEN are stripped from what the API
# container reads, so they never appear inside it.
# ---------------------------------------------------------------------------------------------------------------
# Where the API and Admin images come from. "registry" (default): pull the CI images at IMAGE_TAG and follow it.
# "build": clone WOK_GIT_URL and build both images on this host, only when someone runs `wok update-now [<ref>]`
# (needs ~4 vCPU / 8 GB to build; the timer does nothing). Use it until the registry pipeline (#59/#60) is set up.
# Run the database migrations before each build deploy (`supabase db push`). GHCR_* aren't needed in build mode.
# WOK_SOURCE=registry
# Build mode only. Default https://github.com/juyoungml/nemo-k-cards.git (public: no token) and main.
# WOK_GIT_URL=
# WOK_GIT_REF=
# Registry login for the private images: a GitHub user and a CLASSIC personal access token with only
# read:packages (GHCR doesn't accept fine-grained tokens). Secret. Use a bot or a dedicated token, not one with
# repo scopes.
GHCR_USER=
GHCR_TOKEN=
# Seconds the updater waits for new containers to report healthy before it rolls back. Default 240.
# WOK_HEALTH_TIMEOUT=

# ---------------------------------------------------------------------------------------------------------------
# API (the api container reads everything except the host-only lines; OUTPUT_DIR and AGENT_RUNNER are fixed by
# compose)
# ---------------------------------------------------------------------------------------------------------------
# fixture = replay demo/scenarios (no agents, no cost) | live = real agents. Default fixture.
# DEMO_MODE=
# mock = preview only | dryrun = uploads + Instagram containers, never posts | graph = POSTS PUBLICLY on approval.
# Default mock. Use graph only when a human has decided to go live.
# PUBLISH_MODE=
# Authenticates `claude -p` for live agents (secret). Never a personal Claude login.
ANTHROPIC_API_KEY=
# Model override for agent stages, e.g. sonnet. Empty = CLI default.
# AGENT_MODEL=
# AGENT_TIMEOUT_S=

# Postgres: the Supabase connection string (secret). Use the pooler's SESSION mode (port 5432) unless the
# host has IPv6: direct db.<ref>.supabase.co is IPv6 only. DBOS keeps checkpoints in the `dbos` schema.
DATABASE_URL=
# Only to give DBOS a different connection than DATABASE_URL.
# DBOS_DATABASE_URL=
# Jobs one Organization / this process runs at once (defaults 2 / 4).
# JOBS_PER_ORG=
# JOBS_PER_WORKER=
# POSTS_PER_WORKER=
# Leave unset: the code's pipeline version decides which interrupted Jobs may resume.
# WORKFLOW_VERSION=

# Supabase project: https://<ref>.supabase.co. Every API route except /health needs its sign-in token.
SUPABASE_URL=
# Legacy projects signing with the shared HS256 secret only (secret). New projects use JWKS: leave empty.
SUPABASE_JWT_SECRET=
# Service role key (secret): private slide/material buckets, invitation emails.
SUPABASE_SERVICE_KEY=

# Where people open the Admin, e.g. https://<SITE_ADDRESS>. Invitation links point here; it must be on the
# Supabase Auth redirect allow list.
ADMIN_URL=
# Browser origins allowed to call the API cross-origin, as a JSON list. Not needed through Caddy (same origin).
# CORS_ORIGINS=

# Slide hosting for Instagram: supabase (private bucket + signed links) | local (this API's signed /assets links).
# IMAGE_HOST=
# IMAGE_HOST=local: this API's public URL, e.g. https://<SITE_ADDRESS>/backend
PUBLIC_ASSET_BASE_URL=
# SUPABASE_BUCKET=
# PUBLISH_LINK_TTL_S=
# Key for signed /assets links (secret). Empty = derived from SUPABASE_SERVICE_KEY.
ASSET_SIGNING_KEY=

# Source material files: local (the api_data volume) | supabase (private bucket; needs SUPABASE_SERVICE_KEY).
# MATERIAL_STORE=
# MATERIAL_BUCKET=
# MATERIAL_DIR=

# Connecting an Organization's Instagram account (Instagram API with Instagram Login). Empty = connecting off.
INSTAGRAM_APP_ID=
# Secret.
INSTAGRAM_APP_SECRET=
# https://<SITE_ADDRESS>/backend/instagram-accounts/callback, listed exactly on the Meta app.
INSTAGRAM_REDIRECT_URI=
# INSTAGRAM_API_VERSION=
# INSTAGRAM_ACCOUNTS_PER_ORG=

# Alert emails to Admins: smtps://user:password@host:465 (secret). Empty = alerts are only logged.
SMTP_URL=
# MAIL_FROM=

# Card theme: bold | clean | pop. Default clean.
# THEME=

# OpenShell (AGENT_RUNNER=openshell) is not available from the container yet (#58).
# OPENSHELL_IMAGE=
