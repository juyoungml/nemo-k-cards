# fixture: demo/scenarios 고정 데이터 사용 / live: 실제 에이전트 실행
DEMO_MODE=fixture
# local: 호스트의 claude CLI 직접 실행 (개발용) / openshell: 샌드박스에서 실행
AGENT_RUNNER=local
OPENSHELL_POLICY=../policies/openshell/agent-policy.yaml
OPENSHELL_IMAGE=whatsonkorea-agent:latest
# scripts/openshell_setup.sh가 읽어 OpenShell provider로 등록 (둘 중 하나). 백엔드와 샌드박스는 이 값을 직접 쓰지 않음
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Instagram Graph API — 백엔드에만 존재. 샌드박스로 절대 전달하지 않음
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_ASSET_BASE_URL=

# Public image hosting for Instagram (host only)
IMAGE_HOST=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# External API access: set a strong, private token before exposing FastAPI.
# Admin prompts for this code. Never put it in a NEXT_PUBLIC_ variable.
ADMIN_TOKEN=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# mock: preview only / dryrun: create containers / graph: publish on human approval
PUBLISH_MODE=mock
