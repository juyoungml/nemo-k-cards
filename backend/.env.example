# fixture: demo/scenarios 고정 데이터 사용 / live: 실제 에이전트 실행
DEMO_MODE=fixture
# local: 호스트의 claude CLI 직접 실행 (개발용) / openshell: 샌드박스에서 실행
AGENT_RUNNER=local
# Postgres (Jobs, Brainstorms, policy events). Dev: `supabase db start` (or `supabase start`) at the repo root.
# Staging/production: the Supabase Cloud connection string (host-only secret)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
OPENSHELL_POLICY=../policies/openshell/agent-policy.yaml
OPENSHELL_IMAGE=whatsonkorea-agent:latest
# scripts/openshell_setup.sh가 읽어 OpenShell provider로 등록 (둘 중 하나). 백엔드와 샌드박스는 이 값을 직접 쓰지 않음
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Publishing goes to each Organization's own connected Instagram account (token in Supabase Vault, #21).
# IG_USER_ID / IG_ACCESS_TOKEN are no longer read; PUBLISH_MODE is set below.
# IMAGE_HOST=local only: this API's public URL, where Instagram fetches the signed slide links (e.g. a tunnel)
PUBLIC_ASSET_BASE_URL=

# Connecting an Organization's own Instagram account (Instagram API with Instagram Login), host only.
# From the Meta app: App Dashboard → Instagram → API setup with Instagram login (the Instagram app ID and secret).
# INSTAGRAM_REDIRECT_URI is this API's public callback, e.g. https://<api-host>/instagram-accounts/callback, and must
# be listed exactly under "Valid OAuth Redirect URIs". Empty = connecting is off. Only Pilot Organizations can connect.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v24.0
# Instagram accounts per Organization unless orgs.instagram_account_limit says otherwise (billing will set it)
INSTAGRAM_ACCOUNTS_PER_ORG=1
# Alert emails to Admins (Instagram token revoked or about to expire, #22). Empty = alerts are only logged.
SMTP_URL=
MAIL_FROM=What's On Korea <alerts@whatsonkorea.app>

# Supabase project. Sign-in: every API route except /health needs a Supabase Auth session (empty = all 401).
# Local: `supabase start` at the repo root → http://127.0.0.1:54321. Cloud: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# Only for projects that still sign tokens with the legacy shared JWT secret (HS256). The local CLI and new
# cloud projects use asymmetric signing keys (JWKS), which need nothing here.
SUPABASE_JWT_SECRET=

# Slide hosting for Instagram (host only; uses SUPABASE_URL above). Slides are private: the Admin and Instagram
# get signed links that expire. supabase = PRIVATE bucket (supabase/migrations/*_private_slides.sql) + signed URLs;
# local = this API's /assets route with signed links (PUBLIC_ASSET_BASE_URL must reach it).
# The service key also lets the API email invitations through Supabase Auth; without it the Admin copies
# the invite link by hand.
IMAGE_HOST=local
SUPABASE_SERVICE_KEY=
# Minutes are enough: Instagram copies each image while it builds the container.
PUBLISH_LINK_TTL_S=900
# Key for signed /assets links. Empty = derived from SUPABASE_SERVICE_KEY, else random per process.
ASSET_SIGNING_KEY=

# Source material files (#20), private per Organization under <org_id>/<material_id>/.
# local = MATERIAL_DIR on this host (empty: materials/ next to OUTPUT_DIR); supabase = private bucket `materials`
# (needs SUPABASE_SERVICE_KEY; created by supabase/migrations/*_source_material.sql).
MATERIAL_STORE=local
MATERIAL_DIR=

# Where the Admin runs: invitation links point at ADMIN_URL/invite (must be on the Supabase Auth redirect allow list)
ADMIN_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# mock: preview only / dryrun: create containers / graph: publish on human approval
PUBLISH_MODE=mock
# Durable Jobs (#17): DBOS keeps checkpoints in the `dbos` schema of DATABASE_URL. Set DBOS_DATABASE_URL only to
# give DBOS another connection (e.g. Supabase's session pooler). Per-Organization / per-process caps on running Jobs.
DBOS_DATABASE_URL=
JOBS_PER_ORG=2
JOBS_PER_WORKER=4
# Pipeline version (default: the code's, `workflow_version` in app/config.py; 2 since the Safeguard stage).
# Leave it unset: a value copied here would stay behind when the stage list changes, and old checkpoints would resume.
# WORKFLOW_VERSION=
